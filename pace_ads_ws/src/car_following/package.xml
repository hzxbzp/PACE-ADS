<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_following</name>
  <version>0.0.0</version>
  <description>PACE-ADS (Psychology and Cognition Enabled Automated Driving Systems): CARLA/ROS 2 simulation of the personalization tests</description>
